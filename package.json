{
  "name": "wedges-vue-project",
  "type": "module",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@9.1.2",
  "license": "MIT",
  "repository": "raymondmuller/wedges-vue",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "preview": "pnpm --filter docs preview",
    "prepare": "pnpm simple-git-hooks",
    "wedges:watch": "pnpm --filter wedges-vue build --watch",
    "wedges:build": "pnpm --filter wedges-vue build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bumpp": "bumpp package.json packages/*/package.json apps/*/package.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@babel/runtime@<7.26.10": "7.29.10",
      "@vitest/mocker": "5.0.5",
      "ajv@>=7 <8.18.0": "8.20.0",
      "brace-expansion@2": "2.1.7",
      "braces": "file:vendor/braces",
      "defu@<=6.1.4": "6.1.7",
      "esbuild@<=0.24.2": "0.25.12",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@4": "4.3.2",
      "katex@<0.18.2": "0.19.0",
      "lodash@<=4.17.23": "4.18.1",
      "minimatch@9": "9.0.9",
      "nanoid@<4": "3.3.20",
      "nanoid@>=4 <6": "5.1.16",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <4.0.4": "4.0.7",
      "postcss-selector-parser@<7.1.6": "7.1.7",
      "protocol-buffers-schema@<3.6.1": "3.6.1",
      "tinypool": "2.2.0",
      "vite": "6.4.5",
      "vitest": "5.0.5",
      "yaml@>=1 <1.10.3": "1.10.3",
      "yaml@>=2 <2.8.3": "2.9.1"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
